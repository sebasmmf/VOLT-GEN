<style>

    .categories-section {
        height: max-content;
        padding: 32px 16px;
        background-color: #F3F3F3;
    }
    
    .card-wrapper {
        display: flex;
        flex-direction: column;
        padding: 16px 0;
        gap: 16px;
    }

</style>

{% unless section.settings.title == blank %}
    {% render 'heading-title', title: section.settings.title %}
{% endunless %}

{%  if section.blocks.size > 0 %}
    <div class="card-wrapper">
        {% for block in section.blocks %}
            {% render "category-card",
                title: block.settings.category_title,
                paragraph: block.settings.category_paragraph,
                icon: block.settings.category_icon
            %}
        {% endfor %}
    </div>
{% else %}
    <p>No categories available to display at this time.</p>
{% endif %}



{% schema %}
    {
        "name": "Categories",
        "tag": "section",
        "class": "categories-section",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Title",
                "default": "Browse Categories"
            },
        ],
        "blocks": [
            {
                "type": "category_card",
                "name": "Category Card",
                "settings": [
                    {
                        "type": "text",
                        "id": "category_title",
                        "label": "Title",
                        "default": "Category title"
                    },
                    {
                        "type": "textarea",
                        "id": "category_paragraph",
                        "label": "Description",
                        "default": "Short description of the category."
                    },
                    {
                        "type": "image_picker",
                        "id": "category_icon",
                        "label": "Icon or Image"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "Category Cards",
                "blocks": [
                    { "type": "category_card" },
                    { "type": "category_card" },
                    { "type": "category_card" }
                ]
            }
        ]
        
    }

{% endschema %}