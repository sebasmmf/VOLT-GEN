<style>
    .card-wrapper-units {
        height: 50vh;
        width: 90vw;
        border: 1px solid var(--primary-color);
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        position: relative;
    }

    .card-image-container {
        height: 50%;
        width: 100%;
    }

    .card-image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover; 
    }

    .card-info {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        justify-content: space-between;
        padding: 16px;
    }

    .card-details {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .card-details .card_description {
        color: var(--tertiary-color)

    }

    .card-details .card_description div span {
        font-size: 12px;
    }


    .price-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
    }

    .unit-price {
        font-size: 24px;
        font-weight: bold;
        color: var(--primary-color);
    }

    .add-to-cart-btn {
        background-color: var(--primary-color);
        border: none;
        border-radius: 4px;
        padding: 8px 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .badge {
        height: fit-content;
        width: fit-content;
        padding: 4px 8px;
        border-radius: 2px;
        background-color: var(--primary-color);
        position: absolute;
        top: 10px;
        left: 10px;
        font-size: 10px;
        font-weight: bold;
        color: var(--neutral-color);
    }

    .badge--eco-ready {
        background-color: var(--tertiary-color);
        color: var(--neutral-color) !important;
    }
</style>

{% if product.featured_image != blank %}
    <div class="card-wrapper-units">
    {% unless product.tags == blank %}
        {%- for tag in product.tags -%}
            {%- assign tag_handle = tag | handleize -%}
            {%- if tag_handle == 'eco-ready' -%}
                <span class="badge badge--{{ tag_handle }}">{{ tag | upcase }}</span>
            {%- else -%}
                <span class="badge">{{ tag | upcase }}</span>
            {%- endif -%}

        {%- endfor -%}
    {% endunless %}

        <div class="card-image-container">
                {{ product.featured_image | image_url: width: 600 | image_tag }}
        </div>

        <div class="card-info">
            <div class="card-details">
                <h3>{{ product.title }}</h3>                
                <div class="card_description">{{ product.description }}</div>
            </div>
            <div class="price-row">
                <span class="unit-price">{{ product.price | money_with_currency }}</span>
                <button class="add-to-cart-btn">
                    <img src="{{ 'add-to-cart-icon.svg' | asset_url }}" alt="Cart Icon" width="21" height="21"/>
                </button>
            </div>
        </div>
    </div>
{% endif %}