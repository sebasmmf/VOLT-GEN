{% liquid
  assign bg_color = button_bg | default: 'var(--primary-color)'
  assign txt_color = button_text_color | default: 'var(--neutral-color)'
  assign text = button_text | default: 'Haz clic aquí'
  assign url = button_url | default: '#'
%}

<style>
  .btn {
    color: var(--btn-color);
    background-color: var(--btn-bg);
    padding: 16px 20px;
    border: none;
    border-radius: 2px;
    text-align: center;
    display: inline-block;
    text-decoration: none;
  }
</style>

<a 
  href="{{ url }}" 
  class="btn" 
  style="--btn-bg: var({{ bg_color }}); --btn-color: var({{ txt_color }});"
>
  {{ text | upcase }}
</a>